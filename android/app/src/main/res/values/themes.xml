<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Viper" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/venom</item>
        <item name="android:colorAccent">@color/venom</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Viper.IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/venom</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Viper.PrimaryButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#041004</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Viper.GhostButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/venom</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
